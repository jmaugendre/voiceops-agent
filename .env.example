# Shared secret VoiceOps expects on the `X-VoiceOps-Secret` header for every
# /interventions and /audit request. Configure the same value as a custom
# header when creating each webhook tool in the ElevenLabs dashboard.
# Leave unset for local development -- auth is skipped with a startup warning.
VOICEOPS_WEBHOOK_SECRET=

# How long a prepared update stays valid before the technician must give
# explicit confirmation, in seconds. After this the agent must prepare a new
# transaction.
VOICEOPS_TOKEN_TTL_SECONDS=300
